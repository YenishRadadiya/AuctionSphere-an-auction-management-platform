{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES2018",
    "moduleResolution": "node",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "lib": ["es2015"],
    "strict": true, // (Optional but good for strong typing)
    "resolveJsonModule": true 
  },
  "exclude": ["node_modules"]
}
